# 複製此範例前先決定部署方式；不要把實際密鑰提交 Git。
ACCORD_AUTH_MODE=demo
# 正式串接模式改為 host，以下密鑰需由伺服器環境注入。
ACCORD_HOST_ORIGIN=https://staff.example.com
ACCORD_SSO_ISSUER=company-main
ACCORD_SSO_AUDIENCE=accord
ACCORD_SSO_SECRET=
ACCORD_DIRECTORY_TOKEN=
# 採拉取方式才填 URL；留空時由主網站推送 roster。
ACCORD_DIRECTORY_URL=
# 正式串接請使用獨立空白資料庫。
# VOTE_DB=/absolute/path/accord-host.sqlite3
